# JusticeDesk environment template.
#
# SECRETS ARE NOT STORED HERE. Every value marked <vault> is read at boot from
# /opt/credential-vault/<name> (one secret per file, no trailing newline required).
# See packages/shared/src/config/vault.ts and README.md "Secrets".
#
# Copy to .env for local development only. .env is gitignored.

# ---------- Runtime ----------
NODE_ENV=development
CREDENTIAL_VAULT_DIR=/opt/credential-vault
LOG_LEVEL=info

# ---------- Compliance gate (see COMPLIANCE.md) ----------
# Hard interlock. Must remain false until ethics counsel signs off.
# svc-api refuses to boot when NODE_ENV=production and this is not exactly "true".
COMPLIANCE_REVIEW_COMPLETE=false
# Stripe stays in test mode while the gate is closed. Never set to "live" before sign-off.
PAYMENTS_MODE=test
# Public deployment interlock — staging only for Phase 1.
DEPLOY_TARGET=staging

# ---------- Postgres ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=justicedesk
PGUSER=justicedesk
# PGPASSWORD comes from <vault>/postgres_password
PGPASSWORD_VAULT_KEY=postgres_password
PGSSLMODE=prefer

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD_VAULT_KEY=redis_password

# ---------- MinIO (document vault) ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=justicedesk-documents
MINIO_ACCESS_KEY_VAULT_KEY=minio_access_key
MINIO_SECRET_KEY_VAULT_KEY=minio_secret_key
# Signed URL lifetime in seconds. Short by design — every issue is audit-logged.
MINIO_SIGNED_URL_TTL_SECONDS=300

# ---------- Services ----------
API_PORT=4101
AI_GATEWAY_PORT=4102
API_BASE_URL=http://localhost:4101
AI_GATEWAY_BASE_URL=http://localhost:4102
# Shared secret for svc-api -> svc-ai-gateway calls (gateway is never public).
AI_GATEWAY_SERVICE_TOKEN_VAULT_KEY=ai_gateway_service_token

# ---------- Clerk (auth) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY_VAULT_KEY=clerk_secret_key
CLERK_JWT_ISSUER=

# ---------- Anthropic ----------
# Spec names claude-sonnet-4-6. Configurable here; see README "Model selection".
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY_VAULT_KEY=anthropic_api_key
ANTHROPIC_MAX_TOKENS=16000

# ---------- Stripe (test mode only until compliance gate clears) ----------
STRIPE_SECRET_KEY_VAULT_KEY=stripe_secret_key
STRIPE_WEBHOOK_SECRET_VAULT_KEY=stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Twilio (OTP + deadline reminders) ----------
TWILIO_ACCOUNT_SID_VAULT_KEY=twilio_account_sid
TWILIO_AUTH_TOKEN_VAULT_KEY=twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=
# Reminders are suppressed unless this is "true" (prevents accidental SMS from staging).
SMS_SENDING_ENABLED=false

# ---------- Observability ----------
METRICS_ENABLED=true
ELK_HOST=
ELK_PORT=
